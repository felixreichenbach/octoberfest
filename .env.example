# Signing key for the backend's session cookie (see backend/app/main.py). Any
# value works locally; use a long random string in a real deployment.
SESSION_SECRET=change-me-in-production

# Only needed for the optional `sm-probe` service (docker compose --profile monitoring up).
# Obtain both values from: gcx synthetic-monitoring probes create --name oktoberfest-probe --region <region>
SM_API_SERVER_ADDRESS=synthetic-monitoring-grpc.grafana.net:443
SM_AGENT_API_TOKEN=
